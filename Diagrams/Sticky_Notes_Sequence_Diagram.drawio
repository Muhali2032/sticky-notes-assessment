        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    actor User\n    participant Browser\n    participant URLs as Django URLs\n    participant Views as Notes Views\n    participant Form as NoteForm\n    participant Model as Note Model\n    participant DB as SQLite Database\n\n    User-&gt;&gt;Browser: Open notes page\n    Browser-&gt;&gt;URLs: GET /\n    URLs-&gt;&gt;Views: note_list(request)\n    Views-&gt;&gt;Model: Note.objects.all()\n    Model-&gt;&gt;DB: Retrieve all notes\n    DB--&gt;&gt;Model: Return notes\n    Model--&gt;&gt;Views: Return queryset\n    Views--&gt;&gt;Browser: Render note_list.html\n    Browser--&gt;&gt;User: Display notes\n\n    User-&gt;&gt;Browser: Open create page\n    Browser-&gt;&gt;URLs: GET /create/\n    URLs-&gt;&gt;Views: note_create(request)\n    Views--&gt;&gt;Browser: Render empty form\n\n    User-&gt;&gt;Browser: Submit note details\n    Browser-&gt;&gt;URLs: POST /create/\n    URLs-&gt;&gt;Views: note_create(request)\n    Views-&gt;&gt;Form: Validate submitted data\n    Form--&gt;&gt;Views: Return valid form\n    Views-&gt;&gt;Model: form.save()\n    Model-&gt;&gt;DB: INSERT new note\n    DB--&gt;&gt;Model: Save confirmation\n    Views--&gt;&gt;Browser: Redirect to note_list\n    Browser--&gt;&gt;User: Display updated notes\n\n    User-&gt;&gt;Browser: Request note update\n    Browser-&gt;&gt;URLs: GET /update/pk/\n    URLs-&gt;&gt;Views: note_update(request, pk)\n    Views-&gt;&gt;Model: get_object_or_404(Note, pk)\n    Model-&gt;&gt;DB: Retrieve note\n    DB--&gt;&gt;Model: Return note\n    Model--&gt;&gt;Views: Return note instance\n    Views--&gt;&gt;Browser: Render pre-filled form\n\n    User-&gt;&gt;Browser: Submit updated details\n    Browser-&gt;&gt;URLs: POST /update/pk/\n    URLs-&gt;&gt;Views: note_update(request, pk)\n    Views-&gt;&gt;Form: Validate updated data\n    Form--&gt;&gt;Views: Return valid form\n    Views-&gt;&gt;Model: form.save()\n    Model-&gt;&gt;DB: UPDATE note\n    DB--&gt;&gt;Model: Save confirmation\n    Views--&gt;&gt;Browser: Redirect to note_list\n\n    User-&gt;&gt;Browser: Request note deletion\n    Browser-&gt;&gt;URLs: GET /delete/pk/\n    URLs-&gt;&gt;Views: note_delete(request, pk)\n    Views-&gt;&gt;Model: Retrieve note\n    Model-&gt;&gt;DB: SELECT note\n    DB--&gt;&gt;Model: Return note\n    Views--&gt;&gt;Browser: Render confirmation page\n\n    User-&gt;&gt;Browser: Confirm deletion\n    Browser-&gt;&gt;URLs: POST /delete/pk/\n    URLs-&gt;&gt;Views: note_delete(request, pk)\n    Views-&gt;&gt;Model: note.delete()\n    Model-&gt;&gt;DB: DELETE note\n    DB--&gt;&gt;Model: Deletion confirmation\n    Views--&gt;&gt;Browser: Redirect to note_list\n    Browser--&gt;&gt;User: Display updated notes\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="-1qr5KxXMy1BJ_GLB2wf-12">
